___SANDBOXED_JS_FOR_WEB_TEMPLATE___

// CitationLab Consent — Google Consent Mode v2 defaults, the returning
// visitor's stored decision, then the banner. Fire on Consent Initialization -
// All Pages so it runs before every other tag in the container.

const callInWindow = require('callInWindow');
const encodeUriComponent = require('encodeUriComponent');
const getCookieValues = require('getCookieValues');
const injectScript = require('injectScript');
const JSON = require('JSON');
const makeInteger = require('makeInteger');
const makeString = require('makeString');
const setDefaultConsentState = require('setDefaultConsentState');
const updateConsentState = require('updateConsentState');

const LOADER_URL = 'https://manager.citationlab.ai/api/cl/cmp/';
const COOKIE_NAME = 'cl_consent';
const SIGNALS = [
  'ad_storage',
  'analytics_storage',
  'ad_user_data',
  'ad_personalization',
  'functionality_storage',
  'personalization_storage',
  'security_storage'
];

const token = makeString(data.projectToken || '');
if (!token) {
  data.gtmOnFailure();
  return;
}

const waitForUpdate = makeInteger(data.waitForUpdate);

// Only the two values Consent Mode accepts survive; anything else is denied.
// security_storage is strictly necessary and always granted.
const consentFrom = (source) => {
  const out = {};
  SIGNALS.forEach((signal) => {
    out[signal] = source && source[signal] === 'granted' ? 'granted' : 'denied';
  });
  out.security_storage = 'granted';
  return out;
};

const regionsOf = (row) => {
  return makeString(row.region || '')
    .split(',')
    .map((part) => part.trim().toUpperCase())
    .filter((part) => part.length > 0);
};

const withWait = (state) => {
  if (waitForUpdate > 0) state.wait_for_update = waitForUpdate;
  return state;
};

// 1. Defaults. The global default is all-denied unless a row without a region
//    says otherwise; region rows add region-specific defaults on top.
const rows = data.regionDefaults || [];
let globalRow = null;
rows.forEach((row) => {
  if (regionsOf(row).length === 0 && !globalRow) globalRow = row;
});
setDefaultConsentState(withWait(consentFrom(globalRow)));
rows.forEach((row) => {
  const regions = regionsOf(row);
  if (regions.length === 0) return;
  const state = withWait(consentFrom(row));
  state.region = regions;
  setDefaultConsentState(state);
});

// 2. A returning visitor's stored decision, read before any tag fires so the
//    first page view already carries it. The banner corrects it once it has
//    loaded if the decision no longer stands.
const stored = getCookieValues(COOKIE_NAME, true);
if (stored && stored.length > 0) {
  const decision = JSON.parse(stored[0]);
  if (decision && decision.v === 1 && decision.s) {
    updateConsentState(consentFrom(decision.s));
  }
}

// 3. The banner. Every decision the visitor makes from now on reaches
//    Consent Mode through the Consent API, not through the data layer.
const onDecision = (snapshot) => {
  if (snapshot && snapshot.googleConsent) {
    updateConsentState(consentFrom(snapshot.googleConsent));
  }
};

const onLoaded = () => {
  callInWindow('clConsent.onChange', onDecision);
  data.gtmOnSuccess();
};

injectScript(
  LOADER_URL + encodeUriComponent(token) + '/b.js?gtm=1',
  onLoaded,
  data.gtmOnFailure,
  'citationlab-consent'
);


