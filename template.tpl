___TESTS___

scenarios:
- name: Denies every signal by default and loads the banner
  code: |-
    runCode(mockData);
    assertApi('setDefaultConsentState').wasCalledWith({
      ad_storage: 'denied',
      analytics_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      functionality_storage: 'denied',
      personalization_storage: 'denied',
      security_storage: 'granted',
      wait_for_update: 2000
    });
    assertApi('updateConsentState').wasNotCalled();
    assertThat(injected.url).isEqualTo('https://manager.citationlab.ai/api/cl/cmp/0123456789abcdef0123456789abcdef/b.js?gtm=1');
    assertThat(injected.cacheToken).isEqualTo('citationlab-consent');
    assertThat(listener.path).isEqualTo('clConsent.onChange');
    assertApi('gtmOnSuccess').wasCalled();
- name: Adds a regional default
  code: |-
    mockData.regionDefaults = [{
      region: 'us-ca, US-VA',
      ad_storage: 'granted',
      analytics_storage: 'granted',
      ad_user_data: 'granted',
      ad_personalization: 'granted',
      functionality_storage: 'granted',
      personalization_storage: 'granted'
    }];
    runCode(mockData);
    assertApi('setDefaultConsentState').wasCalledWith({
      ad_storage: 'denied',
      analytics_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      functionality_storage: 'denied',
      personalization_storage: 'denied',
      security_storage: 'granted',
      wait_for_update: 2000
    });
    assertApi('setDefaultConsentState').wasCalledWith({
      ad_storage: 'granted',
      analytics_storage: 'granted',
      ad_user_data: 'granted',
      ad_personalization: 'granted',
      functionality_storage: 'granted',
      personalization_storage: 'granted',
      security_storage: 'granted',
      wait_for_update: 2000,
      region: ['US-CA', 'US-VA']
    });
- name: Applies a returning visitor's stored decision before the banner loads
  code: |-
    mock('getCookieValues', (name) => {
      if (name !== 'cl_consent') return [];
      return ['{"v":1,"g":["necessary","analytics"],"s":{"analytics_storage":"granted","ad_storage":"denied"}}'];
    });
    runCode(mockData);
    assertApi('updateConsentState').wasCalledWith({
      ad_storage: 'denied',
      analytics_storage: 'granted',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      functionality_storage: 'denied',
      personalization_storage: 'denied',
      security_storage: 'granted'
    });
- name: Ignores a cookie it does not recognise
  code: |-
    mock('getCookieValues', (name) => ['not json']);
    runCode(mockData);
    assertApi('updateConsentState').wasNotCalled();
- name: Forwards the visitor's decision to the Consent API
  code: |-
    runCode(mockData);
    listener.callback({ googleConsent: { analytics_storage: 'granted', ad_storage: 'granted', ad_user_data: 'granted', ad_personalization: 'granted', functionality_storage: 'granted', personalization_storage: 'denied', security_storage: 'granted' } });
    assertApi('updateConsentState').wasCalledWith({
      ad_storage: 'granted',
      analytics_storage: 'granted',
      ad_user_data: 'granted',
      ad_personalization: 'granted',
      functionality_storage: 'granted',
      personalization_storage: 'denied',
      security_storage: 'granted'
    });
- name: Fails without a token
  code: |-
    mockData.projectToken = '';
    runCode(mockData);
    assertApi('setDefaultConsentState').wasNotCalled();
    assertApi('gtmOnFailure').wasCalled();
setup: |-
  const mockData = {
    projectToken: '0123456789abcdef0123456789abcdef',
    regionDefaults: [],
    waitForUpdate: '2000'
  };
  const injected = {};
  const listener = {};
  mock('getCookieValues', (name) => []);
  mock('callInWindow', (path, callback) => {
    listener.path = path;
    listener.callback = callback;
  });
  mock('injectScript', (url, onSuccess, onFailure, cacheToken) => {
    injected.url = url;
    injected.cacheToken = cacheToken;
    onSuccess();
  });


___NOTES___

Fire on the Consent Initialization - All Pages trigger. Remove any other Consent Mode default tag from the container.
